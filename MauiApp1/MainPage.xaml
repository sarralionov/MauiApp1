<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             FlowDirection="RightToLeft"
             Title="ניווט בחנות">
    
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="ניווט בחנות" FontSize="28" FontAttributes="Bold" />

            <Label Text="מאיפה מתחילים?" FontSize="18" />
            <Picker x:Name="StartPicker" Title="בחרי נקודת מוצא" />

            <Label Text="לאן רוצים להגיע?" FontSize="18" />
            <Picker x:Name="TargetPicker" Title="בחרי יעד" />

            <Button Text="חשבי מסלול" Clicked="OnNavigateClicked" />

            <Button
    Text="הצג מפה"
    Clicked="OnMapClicked"
    BackgroundColor="#0058A3"
    TextColor="White"
    HeightRequest="55"
    CornerRadius="12" />


            <Label x:Name="StatusLabel" Text="בחרי מוצא ויעד ולחצי על הכפתור."
                   FontSize="18" />
            <Label x:Name="RouteLabel" FontSize="24" FontAttributes="Bold"
                   FlowDirection="LeftToRight" HorizontalTextAlignment="Center" />
            <Label x:Name="LengthLabel" FontSize="18" />

            <Label Text="המפה הראשונה: B = מטבחים, E = תאורה."
                   FontSize="14" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
